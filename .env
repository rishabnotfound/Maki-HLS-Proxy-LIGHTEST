# Cache settings
# Set to 0 to disable caching 5g is 5gb btw
CACHE_SIZE=10g

# Cache expiry (how long unused cache stays before deletion)
# Examples: 1d, 12h, 7d
CACHE_EXPIRY=30m

# OPTIONAL
# openssl rand -hex 32
ENCRYPTION_KEY=

# OPTIONAL - TLS via Let's Encrypt (for direct domain pointing, bypassing CF)
# Leave DOMAIN empty to stay HTTP-only. Domain's A record must point here first.
DOMAIN=
LETSENCRYPT_EMAIL=